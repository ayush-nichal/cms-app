// Migration Steps:
// 1. Run data_migration.sql manually in Supabase SQL editor to translate existing enums to the new primitives.
// 2. Run `npx prisma migrate dev --name v2_schema_overhaul` to drop the old columns and apply the new constraints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  creator
}

enum ContentType {
  text_post
  image_post
  short_form_video
  long_form_video
  carousel_post
}

enum NotificationStatus {
  sent
  failed
  retrying
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password_hash     String
  role              Role
  whatsapp_number   String?
  callmebot_api_key String?
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  assignments       UserChannelAssignment[]
  notification_logs NotificationLog[]
  schedulesCreated  Schedule[] @relation("ScheduleCreator")
}

model Platform {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())

  channels   Channel[]
}

model Channel {
  id          String   @id @default(uuid())
  platform_id String
  name        String
  handle      String
  created_at  DateTime @default(now())

  platform    Platform @relation(fields: [platform_id], references: [id])
  assignments       UserChannelAssignment[]
  schedules         Schedule[]
  notification_logs NotificationLog[]
}

model UserChannelAssignment {
  id         String   @id @default(uuid())
  user_id    String
  channel_id String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  channel    Channel  @relation(fields: [channel_id], references: [id])
}

model Schedule {
  id                String         @id @default(uuid())
  channel_id        String
  created_by        String
  title             String
  content_type      ContentType
  description       String?
  media_url         String?
  scheduled_at      DateTime
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  channel           Channel        @relation(fields: [channel_id], references: [id])
  creator           User           @relation("ScheduleCreator", fields: [created_by], references: [id])
  notification_logs NotificationLog[]
}

model NotificationLog {
  id          String             @id @default(uuid())
  user_id     String
  channel_id  String
  schedule_id String
  channel     String
  sent_at     DateTime
  status      NotificationStatus

  user          User     @relation(fields: [user_id], references: [id])
  targetChannel Channel  @relation(fields: [channel_id], references: [id])
  schedule      Schedule @relation(fields: [schedule_id], references: [id])
}
